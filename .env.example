# Stark & Barker — environment variables
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored; `.env.example` is committed as a template.

# ---- Required ----

# Resend API key. Get one at https://resend.com/api-keys
RESEND_API_KEY=

# ---- Optional ----

# Where contact-form submissions are delivered.
# Defaults to pipelines@starkandbarker.com if unset.
CONTACT_TO_ADDRESS=

# The "From" address Resend sends as.
# Until your domain is verified at Resend, leave this blank — the app will
# fall back to "Stark & Barker <onboarding@resend.dev>" (Resend's sandbox).
# Once your domain is verified, set this to e.g.:
# CONTACT_FROM_ADDRESS=Stark & Barker <hello@starkandbarker.com>
CONTACT_FROM_ADDRESS=
